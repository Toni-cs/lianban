# 华为云 RDS for MySQL。留空则使用本机 sqlite。
DATABASE_URL=sqlite:///data/lianban.db
# 华为云 DCS Redis。留空则使用内存。
REDIS_URL=
# 电脑工作区。留空则使用 data/computer。
COMPUTER_DIR=
# 华为云 ModelArts / MaaS 的 OpenAI 兼容地址。留空则使用本地队友逻辑。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 鸿蒙 Push Kit 服务账号 JSON 与项目 ID。不填也能在应用收件箱里确认。
HUAWEI_SA_FILE=
HUAWEI_PROJECT_ID=
HUAWEI_PUSH_CATEGORY=WORK
HUAWEI_PUSH_TEST=true
HOST=0.0.0.0
PORT=8787
